{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IMBA VK Proxy",
  "version": "1.0.0",
  "identifier": "com.imba.vkproxy",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "IMBA VK Proxy",
        "width": 520,
        "height": 680,
        "resizable": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/*": "resources/"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installMode": "perMachine"
      },
      "requestedExecutionLevel": "requireAdministrator"
    }
  }
}
